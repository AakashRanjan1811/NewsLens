# LLM: mock (offline), groq, or ollama
LLM_PROVIDER=mock

# Groq (free key: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (local): ollama pull llama3.2:3b
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# Live news region for Google News (IN, US, GB, ...)
NEWS_REGION=IN
MAX_ARTICLES_PER_QUERY=15

# Verification
CLUSTER_DISTANCE_THRESHOLD=0.8
SUPPORT_OVERLAP=0.6
MAX_UNMATCHED_WORDS=2
MAX_REVISIONS=2
